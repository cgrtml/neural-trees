Perturbed, $\varepsilon = 0.05$ & @@T_J_IRIS_005@@ & @@T_J_WINE_005@@ & @@T_J_DIGITS_005@@ \\
Perturbed, $\varepsilon = 0.2$ (the default) & @@T_J_IRIS_02@@ & @@T_J_WINE_02@@ & @@T_J_DIGITS_02@@ \\
Perturbed, $\varepsilon = 0.5$ & @@T_J_IRIS_05@@ & @@T_J_WINE_05@@ & @@T_J_DIGITS_05@@ \\
\midrule
Same depth, trained from scratch & @@T_J_IRIS_S@@ & @@T_J_WINE_S@@ & @@T_J_DIGITS_S@@ \\
\bottomrule
\end{tabular}
\caption{Depth four soft decision tree grown one level at a time, as a function
